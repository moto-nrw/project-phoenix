{
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "Current checkin latency. Green < 50ms, Yellow < 100ms, Red > 100ms.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50000000
              },
              {
                "color": "red",
                "value": 100000000
              }
            ]
          },
          "unit": "ns"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {env=\"prod\", service=\"server\"} |= \"/api/iot/checkin\" | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [15m]) by ()",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=\"server\"} |= \"/api/iot/checkin\" | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [15m]) by ()",
          "legendFormat": "P95",
          "refId": "B"
        }
      ],
      "title": "Checkin P50 / P95 (last 15min)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
