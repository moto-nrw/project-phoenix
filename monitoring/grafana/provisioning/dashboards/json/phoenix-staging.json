    {
      "id": 32,
      "title": "Client vs Server Logs (Frontend)",
      "description": "Frontend logs split by context: server-side (SSR/API routes) vs client-side (browser, shipped via /api/logs)",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"frontend\"} | json | __error__=\"\" | context = \"server\" [$__range]))",
          "legendFormat": "Server-side (SSR)",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"frontend\"} | json | __error__=\"\" | context = \"client\" [$__range]))",
