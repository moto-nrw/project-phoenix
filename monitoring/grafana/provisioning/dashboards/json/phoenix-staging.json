{
  "uid": "phoenix-staging",
  "title": "Phoenix Staging",
  "description": "Staging environment monitoring for Phoenix. Covers both Go API (server) and Next.js frontend with structured logging.",
  "tags": [
    "phoenix",
    "staging"
  ],
  "timezone": "Europe/Berlin",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Phoenix Dashboards",
      "type": "dashboards",
      "tags": [
        "phoenix"
      ],
      "asDropdown": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "server",
            "value": "server",
            "selected": false
          },
          {
            "text": "frontend",
            "value": "frontend",
            "selected": false
          }
        ],
        "includeAll": true,
        "multi": true,
        "query": "server,frontend"
      },
      {
        "name": "level",
        "label": "Log Level",
        "type": "custom",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": false
          },
          {
            "text": "WARN",
            "value": "WARN",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          }
        ],
        "includeAll": true,
        "multi": true,
        "query": "ERROR,WARN,INFO,DEBUG"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Requests (Backend)",
      "description": "Total HTTP requests handled by Go server",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "5xx Errors",
      "description": "Server errors (HTTP 500+)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status >= 500 [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "App Errors (All Services)",
      "description": "ERROR-level logs across selected services. Backend uses level=ERROR, frontend uses level=error.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"staging\", service=~\"$service\"} | json | __error__=\"\" | level =~ \"(?i)error\" [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "P95 Latency (Backend)",
      "description": "95th percentile backend response time",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [$__range]) by ()",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100000000
              },
              {
                "color": "red",
                "value": 500000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "HTTP Traffic by Status (Backend)",
      "description": "Requests per minute grouped by status class",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status >= 200 | response_status < 400 [1m]))",
          "legendFormat": "2xx/3xx Success",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status >= 400 | response_status < 500 [1m]))",
          "legendFormat": "4xx Client Error",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status >= 500 [1m]))",
          "legendFormat": "5xx Server Error",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx/3xx Success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx Client Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx Server Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Error & Warning Trend (All Services)",
      "description": "ERROR/WARN logs across backend and frontend over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({env=\"staging\", service=~\"$service\"} | json | __error__=\"\" | level =~ \"(?i)error\" [5m]))",
          "legendFormat": "ERROR ({{service}})",
          "refId": "A"
        },
        {
          "expr": "sum by (service) (count_over_time({env=\"staging\", service=~\"$service\"} | json | __error__=\"\" | level =~ \"(?i)warn\" [5m]))",
          "legendFormat": "WARN ({{service}})",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status >= 500 [5m]))",
          "legendFormat": "5xx Responses (server)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "ERROR.*server"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "ERROR.*frontend"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "WARN.*server"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "WARN.*frontend"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx Responses (server)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Response Latency Percentiles (Backend)",
      "description": "P50/P90/P95/P99 response time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P50 (median)",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.90, {env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "quantile_over_time(0.95, {env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "quantile_over_time(0.99, {env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 2,
            "pointSize": 3
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P50 (median)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P90"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Slowest Endpoints (Backend)",
      "description": "Top 10 endpoints by average response time",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "topk(10, avg_over_time({env=\"staging\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [$__range]) by (request_route))",
          "legendFormat": "{{request_route}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "request_route"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Endpoint"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Avg Latency"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Frontend Structured Logs",
      "collapsed": false,
      "gridPos": {
