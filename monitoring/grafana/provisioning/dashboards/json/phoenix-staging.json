    {
      "id": 33,
      "title": "Top Frontend Components by Log Volume",
      "description": "Which React components/hooks/routes emit the most logs",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "topk(15, sum by (component) (count_over_time({env=\"staging\", service=\"frontend\"} | json | __error__=\"\" | component != \"\" [$__range])))",
          "legendFormat": "{{component}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
