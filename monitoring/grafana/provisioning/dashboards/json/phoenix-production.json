                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Slowest Endpoints (avg latency)",
      "description": "Top 10 endpoints ranked by average response time over the selected range",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "topk(10, avg_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [$__range]) by (request_route))",
          "legendFormat": "{{request_route}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
