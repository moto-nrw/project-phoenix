        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P50 (median)",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.90, {env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P90",
