    {
      "id": 11,
      "title": "RFID Room Scans",
      "description": "RFID scan events from the checkin handler. Shows check-ins (student enters room), check-outs (same-room toggle), and transfers (room change). 'Checkout prompt' means the backend triggered the daily checkout flow \u2014 the student may still stay at school.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"checkin complete\" | json | __error__=\"\" | action = \"checked_in\" [5m]))",
          "legendFormat": "Check-in (room entry)",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"checkin complete\" | json | __error__=\"\" | action = \"checked_out\" [5m]))",
          "legendFormat": "Check-out (same room)",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"checkin complete\" | json | __error__=\"\" | action = \"transferred\" [5m]))",
          "legendFormat": "Transfer (room change)",
          "refId": "C"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"checkin complete\" | json | __error__=\"\" | action = \"checked_out_daily\" [5m]))",
          "legendFormat": "Checkout prompt (daily)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
