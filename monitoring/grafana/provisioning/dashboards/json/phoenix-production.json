        },
        {
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "quantile_over_time(0.99, {env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [5m]) by ()",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 2,
