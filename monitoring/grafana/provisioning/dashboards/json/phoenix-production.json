    {
      "id": 12,
      "title": "Daily Checkout Decisions",
      "description": "What students ACTUALLY chose after the daily checkout prompt. 'Going Home' = confirmed nach Hause (attendance closed). 'Staying' = chose Schulhof/transit (stays checked in). Source: attendance toggle endpoint.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"daily checkout confirmed\" | json | __error__=\"\" | destination = \"zuhause\" [5m]))",
          "legendFormat": "Going Home (zuhause)",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} |= \"daily checkout confirmed\" | json | __error__=\"\" | destination = \"unterwegs\" [5m]))",
          "legendFormat": "Staying (unterwegs)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
