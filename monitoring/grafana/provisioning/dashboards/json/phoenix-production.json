{
  "uid": "phoenix-production",
  "title": "Phoenix Production",
  "description": "Production monitoring for Phoenix Go API. Follows the RED method (Rate, Errors, Duration) and SRE golden signals.",
  "tags": [
    "phoenix",
    "production"
  ],
  "timezone": "Europe/Berlin",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Phoenix Dashboards",
      "type": "dashboards",
      "tags": [
        "phoenix"
      ],
      "asDropdown": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "current": {
          "text": "server",
          "value": "server"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": false
          },
          {
            "text": "server",
            "value": "server",
            "selected": true
          },
          {
            "text": "frontend",
            "value": "frontend",
            "selected": false
          }
        ],
        "includeAll": true,
        "multi": true,
        "query": "server,frontend"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests",
      "description": "Total HTTP requests in selected time range (prod backend only)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "5xx Errors",
      "description": "Server errors (HTTP 500+) in selected time range",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status >= 500 [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "App Errors",
      "description": "Application-level ERROR logs (includes non-HTTP errors)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=~\"$service\"} | json | __error__=\"\" | level = \"ERROR\" [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "P95 Latency",
      "description": "95th percentile response time over selected range",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status != \"\" | unwrap response_latency [$__range]) by ()",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100000000
              },
              {
                "color": "red",
                "value": 500000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "HTTP Traffic by Status",
      "description": "Requests per minute grouped by status class (2xx/4xx/5xx)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status >= 200 | response_status < 400 [1m]))",
          "legendFormat": "2xx/3xx Success",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status >= 400 | response_status < 500 [1m]))",
          "legendFormat": "4xx Client Error",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({env=\"prod\", service=\"server\"} | json | __error__=\"\" | response_status >= 500 [1m]))",
          "legendFormat": "5xx Server Error",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx/3xx Success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx Client Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx Server Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Error Trend",
      "description": "5xx responses, ERROR logs, and WARN logs over time (5-min windows)",
      "type": "timeseries",
      "gridPos": {
