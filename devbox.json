{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "github:NixOS/nixpkgs/5adc50831c259f87faeb09ddf930d43597197473#go_1_27",
    "nodejs_24@latest",
    "pnpm_10@10.34.5",
    "openssl@latest",
    "jq@latest",
    "ripgrep@latest",
    "fd@latest",
    "bat@latest",
    "eza@latest",
    "btop@latest",
    "pgcli@latest",
    "dotenv-linter@latest",
    "lefthook@latest",
    "git-secrets@latest",
    "ni@latest",
    "tree@latest",
    "curl@latest",
    "git@latest",
    "dyff@latest",
    "air@1.67.4",
    "gotestsum@latest",
    "lazydocker@latest",
    "lazygit@latest",
    "gh@latest",
    "glow@latest",
    "yq@latest",
    "xh@latest",
    "pg_activity@latest",
    "go-swag@latest",
    "govulncheck@1.8.0",
    "golangci-lint@2.14.0",
    "fzf@latest",
    "sops@latest",
    "age@latest",
    "graphviz@latest",
    "gopls@0.23.0",
    "typescript-language-server@5.3.0",
    "agent-browser@0.38.2"
  ],
  "env": {
    "CGO_ENABLED": "0",
    "GOFLAGS": "-p=4",
    "GOMAXPROCS": "4",
    "GOTOOLCHAIN": "local"
  },
  "shell": {
    "scripts": {
      "bootstrap":    "scripts/bootstrap-dev.sh",
      "dev":          "scripts/dev-native.sh \"$@\"",
      "doctor":       "node scripts/check-dev-environment.mjs",
      "check-lsp":    "node scripts/check-lsp.mjs",
      "editor":       "zed . \"$@\"",
      "claude":       "scripts/start-claude.sh \"$@\"",
      "codex":        "codex \"$@\"",
      "test-backend": "scripts/test-backend.sh"
    },
    "init_hook": [
      "unset DEVELOPER_DIR",
      "for hook in pre-commit pre-push post-merge; do hook_path=$(git rev-parse --git-path hooks/$hook); test -x \"$hook_path\" && grep -Fqx \"call_lefthook run \\\"$hook\\\" \\\"\\$@\\\"\" \"$hook_path\" || { lefthook install; break; }; done",
      "[ -d frontend/node_modules ] || echo 'Run devbox run bootstrap to install development tools and frontend dependencies.'"
    ]
  }
}
