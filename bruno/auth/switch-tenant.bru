meta {
  name: Switch Tenant
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/auth/switch-tenant
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "tenant_slug": "t2"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isString
  res.body.refresh_token: isString
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.access_token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}
