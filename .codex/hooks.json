{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/check-commit-message.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/format-go.sh'"
          },
          {
            "type": "command",
            "command": "bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/format-typescript.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/check-env-files.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) && bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/skill-reminder.sh''"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) && bash '/Users/flo/Developer/moto/project-phoenix/.codex/hooks/subagent-reminder.sh''"
          }
        ]
      }
    ]
  }
}
