# Docker Compose Environment Variables
#
# This .env file is used by docker-compose directly when running 'docker-compose up'
# It provides environment variables for all services defined in docker-compose.yml
# This is the PRIMARY configuration file for local development with Docker
#
# This .env.example file serves as a template for the actual .env file
# Copy this file to .env and replace the placeholder values with your actual configurations
# IMPORTANT: Never commit your actual .env file to version control

# Timezone Configuration
# Ensures all containers (frontend, backend, database) use the same timezone
# This prevents date calculation mismatches in attendance tracking
TZ=Europe/Berlin

# Database configuration
# Note: SSL is enabled with certificate verification (sslmode=verify-ca) for GDPR compliance and data security
# This requires SSL certificates to be generated with config/ssl/postgres/create-certs.sh
# For Docker container connections:
POSTGRES_PASSWORD=your_secure_db_password
DB_DSN=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres?sslmode=require

# Docker Compose host ports
# Change these per worktree when running multiple Compose projects in parallel.
SERVER_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
MAILPIT_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Test database configuration (for integration tests)
# Start test DB with: docker compose --profile test up -d postgres-test
# The test database runs on port 5433 to avoid conflicts with the dev database
# Change this per worktree when running multiple Compose projects in parallel.
TEST_DB_PORT=5433
TEST_DB_DSN=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5433/phoenix_test?sslmode=disable

# Server configuration
PORT=8080
LOG_LEVEL=debug
LOG_TEXTLOGGING=true
APP_ENV=development
DB_DEBUG=true
ENABLE_CORS=true

# CORS Security Configuration
# Leave empty to allow all origins (development only!)
# For production, restrict to actual domains:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:3000,http://operator.localhost:3000,http://localhost:8080

# Rate Limiting Configuration
# Enable rate limiting to prevent abuse and brute force attacks
# IMPORTANT: Must be enabled in production! Protects against brute-force login attacks.
# NOTE: Rate limiting is per-IP. In Docker, all frontend SSR requests share one IP,
# so limits must account for N concurrent users × ~15 requests per page load.
RATE_LIMIT_ENABLED=false
# General API rate limits (requests per minute / burst size)
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BURST=100
# Stricter limits for authentication endpoints
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Security Logging Configuration
# Enable logging of security events (auth failures, rate limits, etc.)
# IMPORTANT: Must be enabled in production!
SECURITY_LOGGING_ENABLED=false

# Internal Prometheus metrics bearer token.
# Required for backend /internal/metrics and frontend /api/internal/metrics.
METRICS_BEARER_TOKEN=your_metrics_bearer_token_at_least_32_chars

# Sentry Error Tracking
# Leave empty to disable. Get DSN from sentry.io (EU region).
SENTRY_DSN=
# Required when SENTRY_DSN is set. Use development, staging, or production.
SENTRY_ENVIRONMENT=development

# PostHog Product Analytics (backend server-side events)
# Leave empty to disable. Same project API key as NEXT_PUBLIC_POSTHOG_KEY.
POSTHOG_API_KEY=
# Required when POSTHOG_API_KEY is set (EU region).
POSTHOG_HOST=https://eu.i.posthog.com

# Authentication (use strong random strings in production)
AUTH_JWT_SECRET=your_jwt_secret_at_least_32_chars_long
AUTH_JWT_EXPIRY=15m
AUTH_JWT_REFRESH_EXPIRY=168h

# Frontend configuration
# Browser-facing API URL.
# In Docker Compose local development this should stay browser-reachable, so use localhost.
# Server-side frontend requests use API_URL from docker-compose.example.yml instead
# and talk to the backend over the internal Docker network via http://server:8080.
# If you run frontend and backend separately without Docker, set both API_URL
# (in frontend/.env.local) and NEXT_PUBLIC_API_URL to http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_chars
# Trust the Host header from reverse proxy (required when behind nginx/caddy/traefik)
AUTH_TRUST_HOST=true

# Admin Account (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Operator Account (for initial setup via migration)
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=your_secure_operator_password
OPERATOR_DISPLAY_NAME=Administrator

# Email configuration
# Local dev uses Mailpit (catches all emails, web UI at http://localhost:8025)
# Production: Port 465 (implicit SSL/TLS) or 587 (STARTTLS) with real SMTP credentials
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_NAME=moto Dev
EMAIL_FROM_ADDRESS=noreply@localhost
# In production environments FRONTEND_URL must use https:// scheme
FRONTEND_URL=http://localhost:3000
INVITATION_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Multi-Tenancy (Frontend)
# Base domain for subdomain-based tenant routing
TENANT_DOMAIN=localhost
NEXT_PUBLIC_TENANT_DOMAIN=localhost

# Suggestion notification emails (comma-separated)
# When set, new suggestion posts and user comments trigger an email to these addresses
# Example: user1@example.com,user2@example.com
# Leave empty to disable suggestion notifications
SUGGESTION_NOTIFY_EMAIL=

# Operator Subdomain (for session isolation)
NEXT_PUBLIC_OPERATOR_HOSTNAME=operator.localhost:3000

# Parents Subdomain (cross-tenant guardian portal — session-isolated)
NEXT_PUBLIC_PARENTS_HOSTNAME=parents.localhost:3000

# Backend-side parents URL — used for every parent-facing email link
# (status link, accept-guardian-invite, decision emails). Falls back
# to FRONTEND_URL when unset; production must set this explicitly.
PARENTS_URL=http://parents.localhost:3000

# PostHog Product Analytics (EU Cloud)
# NOTE: for deployed builds these NEXT_PUBLIC_* values are build-time-inlined
# via build-args in .github/workflows/build.yml — the SOPS env values do not
# reach the client bundle.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Error Tracking — Frontend (optional, leave empty for local dev)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Development flags
SKIP_ENV_VALIDATION=true
NEXT_TELEMETRY_DISABLED=1
# Frontend structured logging level (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info

# Automated Cleanup (GDPR Compliance)
# Enable automated cleanup of expired visit data
CLEANUP_SCHEDULER_ENABLED=true
# Time to run daily cleanup (24-hour format, e.g., "02:00" for 2 AM)
CLEANUP_SCHEDULER_TIME=02:00
# Cleanup timeout in minutes
CLEANUP_SCHEDULER_TIMEOUT_MINUTES=30

# Session Lifecycle Management
# Enable automatic end of all active sessions at end of day (default: enabled)
SESSION_END_SCHEDULER_ENABLED=true
# Time to automatically end all active sessions (24-hour format, e.g., "18:00" for 6 PM)
SESSION_END_TIME=18:00
# Session end timeout in minutes
SESSION_END_TIMEOUT_MINUTES=10
# Time after which students can check out for the day from their home room
STUDENT_DAILY_CHECKOUT_TIME=15:00

# Abandoned Session Cleanup
# Enable automatic cleanup of abandoned sessions (no activity AND device offline)
SESSION_CLEANUP_ENABLED=true
# How often to check for abandoned sessions (minutes)
SESSION_CLEANUP_INTERVAL_MINUTES=15
# Minutes of inactivity before a session is considered abandoned
# Activity = student RFID scan OR device ping
SESSION_ABANDONED_THRESHOLD_MINUTES=60

# Multi-Tenancy Database Roles
# Password for the phoenix_auth PostgreSQL LOGIN role.
# The serve command auto-connects as phoenix_auth (least-privilege) using this password.
# CLI commands (migrate, seed, cleanup) still connect as the postgres superuser via DB_DSN.
# Required by migration V1.14.1. Use a strong random password in production.
PHOENIX_AUTH_PASSWORD=phoenix_auth_dev

# Device Authentication
# Global PIN for all OGS staff to authenticate devices
OGS_DEVICE_PIN=1234

# Docker BuildKit Configuration (speeds up builds)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_BAKE=true

# Provider email-delivery webhook (#1937)
# Shared HMAC secret the transactional-mail provider signs delivery events
# with. Comma-separated list is accepted so keys can be rotated with overlap.
# Unset means the webhook endpoint answers 503 — it never runs unauthenticated.
EMAIL_WEBHOOK_SIGNING_SECRET=change-me
# Right-hand side of the Message-ID we mint per outgoing mail. Defaults to the
# domain of EMAIL_FROM_ADDRESS when unset.
EMAIL_MESSAGE_ID_DOMAIN=
