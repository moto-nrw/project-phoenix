{
	email y.wenger@gmx.de

	# Cloudflare proxies every public host. Trust only its ranges and take the
	# client IP from CF-Connecting-IP; a forged header sent directly to the
	# origin is ignored. Ranges: https://www.cloudflare.com/ips/
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

# Upstreams see exactly one X-Forwarded-For value: the real client IP.
(client_ip_upstream) {
	header_up X-Forwarded-For {client_ip}
	header_up X-Real-IP {client_ip}
}

# Shared snippet: security headers + gzip
(common) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	encode gzip
}

# Shared snippet: wildcard TLS via Cloudflare DNS challenge
(cloudflare-tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

# Shared snippet: HTML maintenance page when upstream is down
# Uses respond with 200 so Cloudflare does not replace the response
(maintenance-html) {
	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503]`
		handle @maintenance {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			respond `<!DOCTYPE html><html lang="de"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta http-equiv="refresh" content="15"><title>moto - Systemwartung</title><style>*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;background:#fff;color:#1f2937;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem}.card{background:rgba(255,255,255,0.8);backdrop-filter:blur(12px);border-radius:1rem;padding:2.5rem;max-width:42rem;width:100%;text-align:center;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1),0 8px 10px -6px rgba(0,0,0,0.1)}.logo{margin-bottom:2.5rem}.logo img{max-width:150px;height:auto}h1{font-size:2.25rem;font-weight:700;margin-bottom:.75rem;background:linear-gradient(to right,#5080d8,#83cd2d);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}p{color:#374151;line-height:1.6;font-size:1.125rem}.subtitle{color:#9ca3af;font-size:.875rem;margin-top:2rem}.dots{display:flex;justify-content:center;gap:.375rem;margin-top:2rem}.dots span{width:6px;height:6px;border-radius:50%;background:#5080d8;animation:pulse 1.4s ease-in-out infinite}.dots span:nth-child(2){animation-delay:.2s}.dots span:nth-child(3){animation-delay:.4s}@keyframes pulse{0%,80%,100%{opacity:.2;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}@media(prefers-color-scheme:dark){body{background:#0a0f1a;color:#f9fafb}.card{background:rgba(31,41,55,0.8);box-shadow:0 20px 25px -5px rgba(0,0,0,0.3)}h1{color:#f9fafb}p{color:#d1d5db}.subtitle{color:#6b7280}}@media(max-width:640px){h1{font-size:1.75rem}p{font-size:1rem}.card{padding:2rem 1.5rem}}</style></head><body><div class="card"><div class="logo"><img src="data:image/png;base64," alt="MOTO Logo"></div><h1>Systemwartung</h1><p>Das System wird gerade aktualisiert und ist in wenigen Minuten wieder erreichbar.</p><div class="dots"><span></span><span></span><span></span></div><p class="subtitle">Diese Seite aktualisiert sich automatisch.</p></div></body></html>` 200
		}
	}
}

# Shared snippet: JSON maintenance response when API upstream is down
(maintenance-json) {
	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503]`
		handle @maintenance {
			header Content-Type "application/json"
			respond `{"status":"maintenance","error":"System wird aktualisiert. Bitte versuchen Sie es in wenigen Minuten erneut."}` 503
		}
	}
}

# --- Root domain -----------------------------------------------------
www.moto-app.de {
	redir https://moto-app.de{uri} permanent
}

moto-app.de {
	reverse_proxy localhost:3000 {
		import client_ip_upstream
	}
	import common
	import maintenance-html
}

# --- Production API --------------------------------------------------
api.moto-app.de {
	reverse_proxy localhost:8080 {
		import client_ip_upstream
	}
	import common
	import maintenance-json
}

# --- Staging: base domain + API --------------------------------------
staging.moto-app.de {
	reverse_proxy localhost:3001 {
		import client_ip_upstream
	}
	import common
	import maintenance-html
}

api-staging.moto-app.de {
	reverse_proxy localhost:8081 {
		import client_ip_upstream
	}
	import common
	import maintenance-json
}

# --- Grafana ---------------------------------------------------------
grafana.moto-app.de {
	reverse_proxy localhost:3003 {
		import client_ip_upstream
	}
	import common
}

# --- PyrePortal (static SPA) ----------------------------------------
pyreportal.moto-app.de {
	root * /var/www/pyreportal
	import common

	# Hashed build assets are immutable. Missing assets must return 404,
	# not the SPA index.html fallback, otherwise WebView receives HTML as JS/CSS.
	@assetFiles {
		path /assets/*
		file
	}
	handle @assetFiles {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	# system.js is not content-hashed, so force WebView to re-fetch it.
	handle /system.js {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	handle /favicon.png {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA routes and index.html must stay fresh on GKT WebView devices.
	handle {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		try_files {path} /index.html
		file_server
	}
}

