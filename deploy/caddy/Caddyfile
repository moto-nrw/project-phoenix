			<p class="lead">moto wird gerade aktualisiert. Das dauert nur wenige Minuten.</p>
			<p class="status" role="status">Sie müssen nichts tun. Die Seite öffnet sich von selbst wieder.</p>
			</main>
			<script>
			(function () {
			  function check() {
			    fetch("/api/health", { cache: "no-store", redirect: "manual" }).then(function (response) {
			      if (!response.headers.has("X-Moto-Maintenance")) location.replace(location.href);
			    }, function () {});
			  }
			  setInterval(check, 5000);
			})();
			</script>
			</body>
			</html>
			HTML 200
		}
	}
}

# Shared snippet: JSON maintenance response when API upstream is down
(maintenance-json) {
	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503]`
		handle @maintenance {
			header Content-Type "application/json"
			respond `{"status":"maintenance","error":"System wird aktualisiert. Bitte versuchen Sie es in wenigen Minuten erneut."}` 503
		}
	}
}

# --- Root domain -----------------------------------------------------
www.moto-app.de {
	redir https://moto-app.de{uri} permanent
}

moto-app.de {
	reverse_proxy localhost:3000 {
		import client_ip_upstream
	}
	import common
	import maintenance-html
}

# --- Production API --------------------------------------------------
api.moto-app.de {
	reverse_proxy localhost:8080 {
		import client_ip_upstream
	}
	import common
	import maintenance-json
}

# --- Staging: base domain + API --------------------------------------
staging.moto-app.de {
	reverse_proxy localhost:3001 {
		import client_ip_upstream
	}
	import common
	import maintenance-html
}

api-staging.moto-app.de {
	reverse_proxy localhost:8081 {
		import client_ip_upstream
	}
	import common
	import maintenance-json
}

# --- Grafana ---------------------------------------------------------
grafana.moto-app.de {
	reverse_proxy localhost:3003 {
		import client_ip_upstream
	}
	import common
}

# --- PyrePortal (static SPA) ----------------------------------------
pyreportal.moto-app.de {
	root * /var/www/pyreportal
	import common

	# Hashed build assets are immutable. Missing assets must return 404,
	# not the SPA index.html fallback, otherwise WebView receives HTML as JS/CSS.
	@assetFiles {
		path /assets/*
		file
	}
	handle @assetFiles {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	# system.js is not content-hashed, so force WebView to re-fetch it.
	handle /system.js {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	handle /favicon.png {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA routes and index.html must stay fresh on GKT WebView devices.
	handle {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		try_files {path} /index.html
		file_server
	}
}

