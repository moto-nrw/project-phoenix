			h1 { margin-top: 2.5rem; font-size: 1.875rem; line-height: 1.2; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }
			.lead { max-width: 28rem; margin-top: 0.75rem; color: #4b5563; font-size: 0.875rem; line-height: 1.5rem; text-wrap: balance; }
			.status { max-width: 20rem; margin-top: 2rem; text-wrap: balance; color: #6b7280; font-size: 0.875rem; line-height: 1.25rem; }
			@keyframes turn { to { transform: rotate(360deg); } }
			@media (min-width: 40rem) {
			  .ring { width: 7rem; height: 7rem; }
			  h1 { font-size: 2.25rem; }
			  .lead { font-size: 1rem; }
			}
			@media (prefers-reduced-motion: reduce) { .ring { animation: none; } }
			</style>
			</head>
			<body>
			<main>
			<div class="brand">
			<img alt="" width="44" height="32" src="data:image/webp;base64,">
			<svg role="img" aria-label="moto" viewBox="15 -691 2142 679"><path d="M698 -528Q737 -528 763 -476Q789 -424 789 -381Q789 -338 772 -254Q756 -169 720 -90Q685 -12 644 -12Q611 -12 611 -57Q611 -102 637 -204Q663 -306 663 -338Q663 -370 653 -370Q632 -370 603 -324Q574 -278 534 -201Q493 -124 483 -102Q473 -80 466 -67Q460 -54 452 -40Q420 13 367 -40Q340 -67 340 -89Q340 -93 356 -166Q373 -238 373 -331Q373 -370 364 -370Q352 -370 336 -346Q320 -322 287 -259Q254 -196 230 -155Q146 -12 102 -12Q80 -12 48 -49Q15 -86 15 -106Q15 -125 38 -200Q60 -274 66 -358Q73 -442 78 -489Q84 -536 102 -536Q140 -536 176 -504Q211 -473 211 -447Q211 -388 168 -241Q238 -408 286 -467Q337 -528 384 -528Q410 -528 448 -480Q487 -432 487 -390Q487 -349 486 -318Q517 -396 580 -462Q643 -528 698 -528ZM1101 -436Q1058 -411 1016 -331Q973 -251 973 -190Q973 -130 985 -114Q1039 -138 1079 -211Q1119 -284 1119 -348Q1119 -412 1101 -436ZM974 -12Q919 -12 879 -61Q839 -110 839 -180Q839 -305 916 -417Q994 -529 1070 -529Q1146 -529 1198 -476Q1250 -422 1250 -346Q1250 -271 1214 -193Q1178 -115 1113 -64Q1048 -12 974 -12ZM1643 -175Q1668 -175 1668 -141Q1668 -107 1601 -60Q1534 -12 1461 -12Q1429 -12 1385 -47Q1341 -82 1341 -118Q1341 -148 1372 -244Q1402 -341 1413 -377Q1374 -366 1354 -366Q1334 -366 1312 -394Q1290 -421 1290 -446Q1290 -478 1445 -500Q1464 -593 1464 -661Q1464 -691 1494 -691Q1520 -691 1560 -660Q1601 -628 1601 -598Q1601 -567 1588 -512Q1636 -514 1661 -514Q1736 -514 1736 -480Q1736 -458 1692 -442Q1649 -427 1559 -409Q1551 -382 1536 -334Q1520 -285 1498 -212Q1475 -139 1475 -134Q1475 -130 1492 -130Q1508 -130 1570 -152Q1632 -175 1643 -175ZM2008 -436Q1965 -411 1922 -331Q1880 -251 1880 -190Q1880 -130 1892 -114Q1946 -138 1986 -211Q2026 -284 2026 -348Q2026 -412 2008 -436ZM1881 -12Q1826 -12 1786 -61Q1746 -110 1746 -180Q1746 -305 1824 -417Q1901 -529 1977 -529Q2053 -529 2105 -476Q2157 -422 2157 -346Q2157 -271 2121 -193Q2085 -115 2020 -64Q1955 -12 1881 -12Z"/></svg>
