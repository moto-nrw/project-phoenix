{
	email y.wenger@moto-ogs.de

	# Cloudflare proxies every public host. Trust only its ranges and take the
	# client IP from CF-Connecting-IP; a forged header sent directly to the
	# origin is ignored. Ranges: https://www.cloudflare.com/ips/
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

# Upstreams see exactly one X-Forwarded-For value: the real client IP.
# Requests from Cloudflare are trusted, so Caddy would otherwise pass a
# client-sent X-Forwarded-Host through. The frontend derives tenant and
# portal from it, so it always carries the host the request was sent to.
# X-Moto-Original-* is set by the frontend proxy only, never by a client.
(client_ip_upstream) {
	header_up X-Forwarded-For {client_ip}
	header_up X-Real-IP {client_ip}
	header_up X-Forwarded-Host {host}
	header_up -X-Moto-Original-*
}

# Shared snippet: security headers + gzip
(common) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	encode gzip
}

# Shared snippet: wildcard TLS via Cloudflare DNS challenge
(cloudflare-tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

# Shared snippet: HTML maintenance page when upstream is down (deploys).
# Uses respond with 200 so Cloudflare does not replace the response.
# The page follows the frontend's 404 screen (frontend/src/app/not-found.tsx)
# and carries logo and wordmark inline: no upstream serves assets now.
# Its script asks /api/health every 5 s and reopens the address once the
# answer lacks X-Moto-Maintenance, which only this snippet sets.
# In the page: no backslash and no dollar sign after an opening brace
# (Caddy would read both).
(maintenance-html) {
	handle_errors {
		@maintenance expression `{err.status_code} in [502, 503]`
		handle @maintenance {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			header X-Moto-Maintenance "1"
			respond <<HTML
			<!doctype html>
			<html lang="de">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta name="robots" content="noindex">
			<meta name="color-scheme" content="light">
			<meta name="theme-color" content="#f9fafb">
			<noscript><meta http-equiv="refresh" content="15"></noscript>
			<title>Gleich geht es weiter | moto</title>
			<style>
			*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
			html { -webkit-text-size-adjust: 100%; }
			body {
			  position: relative;
			  display: flex;
			  min-height: 100vh;
			  min-height: 100dvh;
			  flex-direction: column;
			  align-items: center;
			  justify-content: center;
			  overflow: hidden;
			  padding: 4rem 1rem;
			  background: #f9fafb;
			  color: #030712;
			  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
			  -webkit-font-smoothing: antialiased;
			  text-align: center;
			}
			body::before {
			  position: absolute;
			  inset: 0;
			  pointer-events: none;
			  content: "";
			  background-image: radial-gradient(circle at 1px 1px, rgba(17, 24, 39, 0.12) 1px, transparent 0);
			  background-size: 14px 14px;
			  -webkit-mask-image: radial-gradient(circle at center, black 0, black 58%, rgba(0, 0, 0, 0.62) 80%, transparent 100%);
			  mask-image: radial-gradient(circle at center, black 0, black 58%, rgba(0, 0, 0, 0.62) 80%, transparent 100%);
			}
			main { position: relative; display: flex; flex-direction: column; align-items: center; }
			.brand { display: flex; align-items: center; justify-content: center; gap: 0.75rem; }
			.brand img { width: 2.75rem; height: 2rem; object-fit: contain; }
