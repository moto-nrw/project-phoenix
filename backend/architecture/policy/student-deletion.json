        "production"
      ],
      "source_owner": "student-deletion",
      "source_role": "public",
      "target_owner": "care-plan",
      "target_role": "public"
    },
    {
      "id": "student-deletion.compose.deletion.delivery-platform.public",
      "description": "Wire the child lifecycle owner workflow required by #2710 without legacy repository orchestration.",
      "scopes": [
        "production"
      ],
      "source_owner": "student-deletion",
      "source_role": "compose",
      "target_owner": "delivery-platform",
      "target_role": "public"
    },
    {
      "id": "student-deletion.compose.database-binding",
      "description": "Bind owner adapters to the shared database and ambient UnitOfWork; no workflow SQL (#2710).",
      "scopes": [
        "production"
      ],
      "source_owner": "student-deletion",
      "source_role": "compose",
      "target_class": "orm-sql"
    },
    {
      "id": "student-deletion.public.crypto",
      "description": "The deletion preview fingerprint is a SHA-256 digest compared in constant time (#2710).",
      "scopes": [
        "production"
      ],
      "source_owner": "student-deletion",
      "source_role": "public",
      "target_class": "crypto"
    },
    {
