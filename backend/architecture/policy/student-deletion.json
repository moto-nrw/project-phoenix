      "id": "student-deletion.to.people-directory",
      "description": "Student Deletion coordinates the public owner capability required by #2710.",
      "scopes": [
        "production"
      ],
      "source_owner": "student-deletion",
      "source_role": "public",
      "target_owner": "people-directory",
      "target_role": "public"
    },
    {
      "id": "student-deletion.to.care-plan",
      "description": "Student Deletion coordinates the public owner capability required by #2710.",
