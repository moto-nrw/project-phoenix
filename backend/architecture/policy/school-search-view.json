{
  "packages": [
    {
      "path": "modules/schoolsearchview",
      "owner": "school-search-view",
      "role": "public",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "modules/schoolsearchview/compose",
      "owner": "school-search-view",
      "role": "compose",
      "internal_test_role": "module-internal-test",
      "external_test_role": "workflow-integration-test"
    },
    {
      "path": "modules/schoolsearchview/http",
      "owner": "school-search-view",
      "role": "http",
      "internal_test_role": "adapter-test",
      "external_test_role": "adapter-test"
    },
    {
      "path": "modules/schoolsearchview/internal/application",
      "owner": "school-search-view",
      "role": "application",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "modules/schoolsearchview/internal/adapters/postgres",
      "owner": "school-search-view",
      "role": "postgres",
      "internal_test_role": "module-internal-test",
      "external_test_role": "workflow-integration-test"
    }
  ],
  "rules": [
    {
      "id": "school-search-view.application.public",
      "description": "ADR 0227: the search answers in the projection's public contract and reads Enrollment's answers through its consumer port.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "application",
      "target_owner": "school-search-view",
      "target_role": "public"
    },
    {
      "id": "school-search-view.postgres.public",
      "description": "ADR 0227: the search statements answer in the projection's public hit values.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "postgres",
      "target_owner": "school-search-view",
      "target_role": "public"
    },
    {
      "id": "school-search-view.postgres.facilities-public",
      "description": "ADR 0227: the room search leaves out the same system rooms as Facilities' room list, by Facilities' own names.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "postgres",
      "target_owner": "facilities",
      "target_role": "public"
    },
    {
      "id": "school-search-view.compose.tenant-runtime",
      "description": "ADR 0227: composition binds only the existing school transaction and its tenant.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "compose",
      "target_owner": "tenant-runtime",
      "target_role": "public"
    },
    {
      "id": "school-search-view.compose.orm-sql",
      "description": "ADR 0227: composition binds the existing BUN school transaction to the private projection adapter.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "compose",
      "target_class": "orm-sql"
    },
    {
      "id": "school-search-view.http.public",
      "description": "ADR 0227: the search route calls the projection's one public capability.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "http",
      "target_owner": "school-search-view",
      "target_role": "public"
    },
    {
      "id": "school-search-view.http.tenant-runtime.common",
      "description": "ADR 0227: the search route uses the shared HTTP request, principal and response helpers.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "http",
      "target_owner": "tenant-runtime",
      "target_role": "http",
      "target_package": "api/common"
    },
    {
      "id": "school-search-view.http.identity-access.http",
      "description": "ADR 0227: the search route reads the caller's permissions from the session token.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "http",
      "target_owner": "identity-access",
      "target_role": "http",
      "target_package": "modules/identityaccess/sessiontoken"
    },
    {
      "id": "school-search-view.http.security-runtime.contract",
      "description": "ADR 0227: the search route names the staff permissions of the pages a hit leads to.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "http",
      "target_owner": "security-runtime",
      "target_role": "contract"
    },
    {
      "id": "school-search-view.http.security-runtime.public",
      "description": "ADR 0227: the search route decides the scope with Security Runtime's permission helpers.",
      "scopes": [
        "production"
      ],
      "source_owner": "school-search-view",
      "source_role": "http",
      "target_owner": "security-runtime",
      "target_role": "public"
    }
  ],
  "read_projections": [
    {
      "id": "school-search-view",
      "package": "modules/schoolsearchview/internal/adapters/postgres",
      "data_objects": [
        "education.groups",
        "facilities.rooms",
        "users.guardian_phone_numbers",
        "users.guardian_profiles",
        "users.persons",
        "users.staff_school_memberships",
        "users.student_guardian_relationships",
        "users.student_profiles",
        "users.student_school_memberships"
      ],
      "tenant_safe": true
    }
  ]
}
