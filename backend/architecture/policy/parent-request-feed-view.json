{
  "packages": [
    {
      "path": "modules/parentrequestfeedprojection/internal/adapters/postgres",
      "owner": "parent-request-feed-view",
      "role": "postgres",
      "internal_test_role": "workflow-integration-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "modules/parentrequestfeedprojection/compose",
      "owner": "parent-request-feed-view",
      "role": "compose",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    }
  ],
  "rules": [
    {
      "id": "parent-request-feed-view.integration-test.support",
