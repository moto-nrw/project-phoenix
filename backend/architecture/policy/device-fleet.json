        "internal_test"
      ],
      "source_owner": "device-fleet",
      "source_role": "workflow-integration-test",
      "target_owner": "test-support",
      "target_role": "test-support"
    },
    {
      "id": "device-fleet.integration-test.device-fleet-application",
