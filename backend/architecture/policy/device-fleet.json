        "production"
      ],
      "source_owner": "device-fleet",
      "target_class": "crypto",
      "source_role": "adapter"
    },
    {
      "id": "device-fleet.port-domain",
      "description": "Device Fleet ports express persistence operations using their own domain values.",
      "scopes": [
        "production"
      ],
      "source_owner": "device-fleet",
      "source_role": "port",
      "target_role": "domain",
      "same_owner": true
    },
    {
      "id": "device-fleet.compose.orm-sql",
