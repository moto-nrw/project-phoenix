    {
      "id": "device-fleet.compose.care-plan.public",
      "description": "Native Care Plan capability after complete retirement of inbound-schedules (#3351, ADR 0030).",
      "scopes": [
        "production"
      ],
      "source_owner": "device-fleet",
      "source_role": "compose",
      "target_owner": "care-plan",
      "target_role": "public"
    },
    {
      "id": "external.crypto.device-fleet.adapter",
