      "scopes": [
        "production"
      ],
      "source_owner": "device-fleet",
      "source_role": "compose",
      "target_owner": "facilities",
      "target_role": "public"
    },
    {
      "id": "device-fleet.compose.student-presence-public",
      "description": "Device Fleet composition reads live presence facts through the public Student Presence capability.",
      "scopes": [
        "production"
      ],
      "source_owner": "device-fleet",
      "source_role": "compose",
      "target_owner": "student-presence",
      "target_role": "public"
    },
    {
