        "internal_test",
        "external_test"
      ],
      "source_owner": "device-fleet",
      "source_role": "workflow-integration-test",
      "target_owner": "device-fleet",
      "target_role": "application"
    },
    {
      "id": "device-fleet.device-auth.device-fleet-adapter",
