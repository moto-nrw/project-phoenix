    {
      "id": "external.crypto.identity-access.production.public",
      "description": "Existing Identity & Access token primitives and implementation use cryptography only in this role and scope; HTTP receives no crypto grant.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "public",
      "target_class": "crypto"
    },
    {
      "id": "external.crypto.identity-access.internal_test.module-internal-test",
      "description": "Existing Identity & Access token primitives and implementation use cryptography only in this role and scope; HTTP receives no crypto grant.",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "identity-access",
      "source_role": "module-internal-test",
      "target_class": "crypto"
    },
    {
      "id": "external.crypto.identity-access.external_test.e2e-test",
      "description": "Existing Identity & Access token primitives and implementation use cryptography only in this role and scope; HTTP receives no crypto grant.",
      "scopes": [
        "external_test"
      ],
      "source_owner": "identity-access",
      "source_role": "e2e-test",
      "target_class": "crypto"
    },
    {
      "id": "identity-access.postgres.compose-extraction.tenant-runtime.tenant",
      "description": "ADR 0058 #4084: exact-package successor of the owner composition reach; existing owner direction and public/owned-port contract only.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "postgres",
      "source_package": "modules/identityaccess/internal/adapters/postgres",
      "target_owner": "tenant-runtime",
