  "rules": [
    {
      "id": "identity-access.port-domain",
      "description": "Identity & Access ports express persistence operations using their own domain values.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "port",
      "target_role": "domain",
      "same_owner": true
    },
    {
      "id": "identity-access.application.tenant-runtime",
      "description": "Identity & Access application code scopes the operator's school-wide MFA writes to the school they name (ADR 0058 addendum point 2, #4084).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "application",
      "target_owner": "tenant-runtime",
      "target_role": "public"
    },
    {
      "id": "identity-access.application.transaction-runtime",
      "description": "Identity & Access application code marks a store's missing row through the transaction runtime's no-rows sentinel (ADR 0058 addendum point 2, #4084).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "application",
      "target_owner": "transaction-runtime",
      "target_role": "public"
    },
    {
      "id": "identity-access.module-internal-test.tenant-runtime",
      "description": "The internal tests of the Identity & Access application read the tenant the MFA writes ran under (ADR 0058 addendum point 4, #4084).",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "identity-access",
      "source_role": "module-internal-test",
      "target_owner": "tenant-runtime",
      "target_role": "public"
    },
    {
      "id": "identity-access.compose.orm-sql",
      "description": "Identity & Access composition supplies the concrete Bun database dependency.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "compose",
      "target_class": "orm-sql"
    },
    {
      "id": "identity-access.compose.tenant-runtime",
      "description": "Identity & Access composition binds the shared tenant transaction runtime.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "compose",
      "target_owner": "tenant-runtime",
      "target_role": "public"
    },
    {
      "id": "identity-access.integration-test.support",
      "description": "Identity & Access integration tests use hermetic database support.",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "identity-access",
      "source_role": "workflow-integration-test",
      "target_owner": "test-support",
      "target_role": "test-support"
    },
    {
      "id": "identity-access.http.public",
      "description": "The operator identity routes call the public Identity & Access capability (#3252).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "http",
      "target_owner": "identity-access",
      "target_role": "public"
    },
    {
      "id": "identity-access.http.tenant-runtime.common",
      "description": "The operator identity routes use the shared HTTP request and response helpers (#3252).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "http",
      "target_owner": "tenant-runtime",
      "target_role": "http",
      "target_package": "api/common"
    },
    {
      "id": "identity-access.http.token-claims",
      "description": "The operator identity routes read the verified operator claims and the refresh recovery proof (#3252).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "http",
      "target_owner": "identity-access",
      "target_role": "http"
    },
    {
      "id": "identity-access.http.refresh-rotation",
      "description": "The operator refresh route passes the rotation recovery proof to the capability (#3252).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "http",
      "target_owner": "identity-access",
      "target_role": "application"
    },
    {
      "id": "identity-access.http.settings-public",
      "description": "The tenant shell of the account routes reads the tenant settings through the public Settings Platform contract (#2736).",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "http",
      "target_owner": "settings-platform",
      "target_role": "public"
    },
    {
      "id": "identity-access.e2e-test.session-runtime",
      "description": "Identity & Access e2e-test reaches its own session token runtime, which carries the http role (ADR 0057 point 3).",
      "scopes": [
        "external_test"
      ],
      "source_owner": "identity-access",
      "source_role": "e2e-test",
      "target_owner": "identity-access",
      "target_role": "http"
    },
    {
      "id": "identity-access.module-behavior-test.session-runtime",
      "description": "Identity & Access module-behavior-test reaches its own session token runtime, which carries the http role (ADR 0057 point 3).",
      "scopes": [
        "external_test"
      ],
      "source_owner": "identity-access",
      "source_role": "module-behavior-test",
      "target_owner": "identity-access",
      "target_role": "http"
    },
    {
      "id": "external.crypto.identity-access.production.application",
      "description": "Existing Identity & Access token primitives and implementation use cryptography only in this role and scope; HTTP receives no crypto grant.",
      "scopes": [
        "production"
      ],
      "source_owner": "identity-access",
      "source_role": "application",
      "target_class": "crypto"
    },
    {
      "id": "external.crypto.identity-access.production.domain",
