  "rules": [
    {
      "id": "organization-tenancy.port-domain",
      "description": "Organization and Tenancy ports express persistence operations using their own domain values.",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "port",
      "target_role": "domain",
      "same_owner": true
    },
    {
      "id": "organization-tenancy.compose.orm-sql",
      "description": "Organization and Tenancy composition supplies the concrete Bun database dependency.",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "compose",
      "target_class": "orm-sql"
    },
    {
      "id": "organization-tenancy.internal-test.tenant-runtime",
      "description": "Organization and Tenancy composition tests verify transaction and lock behavior through the shared tenant runtime.",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "workflow-integration-test",
      "target_owner": "tenant-runtime",
      "target_role": "public"
    },
    {
      "id": "organization-tenancy.integration-test.support",
      "description": "Organization and Tenancy integration tests use hermetic database support.",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "workflow-integration-test",
      "target_owner": "test-support",
      "target_role": "test-support"
    },
    {
      "id": "organization-tenancy.http.public",
      "description": "The operator provisioning routes call the public Organisation & Tenancy provisioning capability (#3232).",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "http",
      "target_owner": "organization-tenancy",
      "target_role": "public"
    },
    {
      "id": "organization-tenancy.http.tenant-runtime.common",
      "description": "The operator provisioning routes use the shared HTTP helpers and the operator error bodies (#3232). Owner HTTP adapters and their tests use the shared inbound helpers and the session token adapter as a target dependency (ADR 0031, #2736).",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "http",
      "target_owner": "tenant-runtime",
      "target_role": "http",
      "target_package": "api/common"
    },
    {
      "id": "organization-tenancy.http.token-claims",
      "description": "The operator provisioning routes read the verified operator claims (#3232). Owner HTTP adapters and their tests use the shared inbound helpers and the session token adapter as a target dependency (ADR 0031, #2736).",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "http",
      "target_owner": "identity-access",
      "target_role": "http"
    },
    {
      "id": "organization-tenancy.adapter-test.tenant-runtime.common",
      "description": "The provisioning route tests assert the operator error bodies and request IDs (#3232). Owner HTTP adapters and their tests use the shared inbound helpers and the session token adapter as a target dependency (ADR 0031, #2736).",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "adapter-test",
      "target_owner": "tenant-runtime",
      "target_role": "http",
      "target_package": "api/common"
    },
    {
      "id": "organization-tenancy.adapter-test.token-claims",
      "description": "The provisioning route tests authenticate the operator through its claims (#3232). Owner HTTP adapters and their tests use the shared inbound helpers and the session token adapter as a target dependency (ADR 0031, #2736).",
      "scopes": [
        "internal_test"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "adapter-test",
      "target_owner": "identity-access",
      "target_role": "http"
    },
    {
      "id": "organization-tenancy.postgres.compose-extraction.tenant-runtime.tenant",
      "description": "ADR 0058 #4084: exact-package successor of the owner composition reach; existing owner direction and public/owned-port contract only.",
      "scopes": [
        "production"
      ],
      "source_owner": "organization-tenancy",
      "source_role": "postgres",
      "source_package": "modules/organizationtenancy/internal/adapters/postgres",
      "target_owner": "tenant-runtime",
      "target_role": "public",
      "target_package": "tenant"
    }
  ],
