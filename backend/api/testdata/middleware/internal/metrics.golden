# Each unindented line is a middleware chain, outermost first.
# The indented routes below it run through exactly that chain.

api.requestIDs.# > api/common.ProblemResponseMiddleware > api/common.TenantRuntimeMiddleware.# > api/common.AuthorizationObserverMiddleware.# > api/common.TenantRuntimeObserverMiddleware.# > api/common.TenantRequestObserverMiddleware.# > github.com/go-chi/chi/v5/middleware.ClientIPFromXFFTrustedProxies.# > api.syncClientIPToRemoteAddr > api.(*httpMetrics).middleware-fm > github.com/samber/slog-chi.NewWithConfig.# > github.com/go-chi/chi/v5/middleware.Recoverer > api.ServerErrorReporting > middleware.SecurityHeaders > api.RequestSettingsCacheMiddleware > api.RequestIdentityCacheMiddleware > github.com/go-chi/jwtauth/v5.Verify.# > api.moduleRoutesMiddleware.# > api.SentrySessionContext > analytics.CoreActionMiddleware.# > api.metricsAuthMiddleware.#
	CONNECT /internal/metrics
	DELETE /internal/metrics
	GET /internal/metrics
	HEAD /internal/metrics
	OPTIONS /internal/metrics
	PATCH /internal/metrics
	POST /internal/metrics
	PUT /internal/metrics
	QUERY /internal/metrics
