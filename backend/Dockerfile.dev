# syntax=docker/dockerfile:1
# Development Dockerfile with hot reload via air
FROM golang:1.27.0-alpine3.24

ENV GOTOOLCHAIN=local

# Keep the container and Devbox hot-reload tool on the same pinned release.
RUN apk --no-cache add ca-certificates bash tzdata git # NOSONAR
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@v1.67.4

WORKDIR /app

# Copy go mod files first for dependency caching
COPY go.mod go.sum ./
RUN go mod download

# Source code will be mounted as volume
# air will watch for changes and rebuild

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
