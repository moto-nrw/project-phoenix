      "target_owner": "clock",
      "target_role": "public"
    },
    {
      "id": "flow.public.board-public",
      "description": "The workflow reads the board projection.",
      "scopes": [
        "production"
      ],
      "source_owner": "flow",
      "source_role": "public",
      "target_owner": "board",
      "target_role": "public"
    },
    {
      "id": "alpha.http.beta-session",
