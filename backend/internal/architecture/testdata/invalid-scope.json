{
  "schema_version": 1,
  "policy_epoch": 1,
  "module_path": "example.test/architecture-fixture",
  "shared_kernel_types": [
    "CorrelationID",
    "Date",
    "TenantID",
    "WallClock"
  ],
  "build": {
    "goos": "linux",
    "goarch": "amd64",
    "cgo_enabled": false
  },
  "owners": [
    {
      "id": "source",
      "kind": "domain"
    },
    {
      "id": "target",
      "kind": "domain"
    }
  ],
  "roles": [
    "application",
    "domain",
    "module-behavior-test",
    "module-internal-test"
  ],
  "packages": [
    {
      "path": "source",
      "owner": "source",
      "role": "application",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "target",
      "owner": "target",
      "role": "domain",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    }
  ],
  "external_classes": [],
  "external_packages": [],
  "rules": [
    {
      "id": "source-uses-target",
      "description": "The fixture source may call its target.",
      "scopes": [
        "all"
      ],
      "source_owner": "source",
      "source_role": "application",
      "target_owner": "target",
      "target_role": "domain",
      "target_class": ""
    }
  ]
}
