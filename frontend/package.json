{
  "name": "phoenix-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "oxlint . && tsc --noEmit",
    "check:fresh": "rm -f *.tsbuildinfo && oxlint . && tsc --noEmit",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "PHOENIX_E2E_HARNESS=1 knip",
    "e2e": "cd ../backend && go run . e2e run"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@moto-nrw/design-system": "^0.5.2",
    "@radix-ui/react-focus-scope": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.51.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "axios": "^1.16.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "next-auth": "5.0.0-beta.31",
    "posthog-js": "^1.372.6",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.11.0",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "smol-toml@<1.6.1": "1.6.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "next-auth>next": ">=14"
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mdx}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "knip": {
    "entry": [
      "src/app/**/*.{ts,tsx}",
      "src/env.js",
      "src/sentry.client.config.ts",
      "src/sentry.server.config.ts",
      "src/lib/utils.ts",
      "src/lib/image-utils.ts",
      "src/lib/database/configs/*.{ts,tsx}",
      "src/lib/swr/index.ts",
      "src/server/auth/token-refresh.ts",
      "src/server/auth/shared.ts",
      "src/server/auth/operator.ts",
      "src/**/*.test.{ts,tsx}",
      "src/test/mocks/*.ts",
      "src/test/fixtures/*.ts",
      "src/test/helpers/*.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx,js}"
    ],
    "ignoreBinaries": [
      "go"
    ],
    "ignoreDependencies": [
      "sharp",
      "lint-staged",
      "@fontsource/geist-sans",
      "@moto-nrw/design-system"
    ]
  }
}
