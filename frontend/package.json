{
  "name": "phoenix-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "check:fresh": "rm -f *.tsbuildinfo && eslint . && tsc --noEmit",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.10",
    "axios": "^1.13.5",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "recharts": "2.15.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.0",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.1.0",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "next-auth>next": ">=14"
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mdx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ]
  },
  "knip": {
    "entry": [
      "src/app/**/*.{ts,tsx}",
      "src/env.js",
      "src/lib/utils.ts",
      "src/lib/image-utils.ts",
      "src/lib/database/configs/*.{ts,tsx}",
      "src/lib/swr/index.ts",
      "src/server/auth/token-refresh.ts",
      "src/**/*.test.{ts,tsx}",
      "src/test/mocks/*.ts",
      "src/test/fixtures/*.ts",
      "src/test/helpers/*.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx,js}"
    ],
    "ignoreDependencies": [
      "sharp",
      "lint-staged",
      "@fontsource/geist-sans"
    ]
  }
}
