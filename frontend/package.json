{
  "name": "phoenix-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "next build",
    "build-storybook": "node scripts/build-storybook.mjs",
    "check": "node scripts/verify-locales.mjs && oxlint . && tsc --noEmit",
    "check:fresh": "rm -f *.tsbuildinfo && node scripts/verify-locales.mjs && oxlint . && tsc --noEmit",
    "depcruise": "dependency-cruise --config .dependency-cruiser.cjs src",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "generate:guides": "playwright test -c playwright.guides.config.ts",
    "generate:locales": "node scripts/generate-locales.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:build-env": "node scripts/validate-build-env.mjs",
    "knip": "knip",
    "knip:production": "knip --production --include files",
    "perf:trace": "playwright test -c playwright.perf.config.ts",
    "perf:render": "playwright test -c playwright.perf-dev.config.ts",
    "perf:report": "node scripts/perf/report.mjs",
    "perf:bundle": "node scripts/perf/analyze.mjs",
    "perf:bundle-report": "node scripts/perf/bundle-report.mjs",
    "perf:bundle-ratchet": "node scripts/perf/bundle-ratchet.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.0",
    "@moto-nrw/design-system": "^0.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-focus-scope": "^1.1.16",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.70.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "axios": "^1.19.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.6",
    "posthog-js": "^1.415.2",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-scan": "0.5.7",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mdx}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "knip": {
    "includeEntryExports": true,
    "playwright": {
      "config": [],
      "entry": [
        "**/*.@(spec|test).?(c|m)[jt]s?(x)",
        "scripts/perf/*.perf.ts",
        "playwright.config.ts",
        "playwright.guides.config.ts",
        "e2e/**/*.ts"
      ]
    },
    "project": [
      "src/**/*.{js,jsx,ts,tsx}!",
      "src/**/*.css!",
      "scripts/**/*.{js,mjs,ts}",
      "!src/test/**!",
      "!src/**/*.{test,spec,stories}.{js,jsx,ts,tsx}!"
    ],
    "ignore": [
      ".storybook/mocks/**"
    ],
    "ignoreDependencies": [
      "sharp",
      "lint-staged",
      "react-scan"
    ]
  }
}
