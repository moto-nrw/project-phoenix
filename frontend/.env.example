# Local environment configuration for development
# This file should not be committed to version control
# Copy this file to .env.local and replace placeholders with your actual values

# Next Auth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your_nextauth_secret" # In production, generate with: openssl rand -base64 32
AUTH_JWT_EXPIRY=15m
AUTH_JWT_REFRESH_EXPIRY=168h
METRICS_BEARER_TOKEN=your_metrics_bearer_token_at_least_32_chars

# API Configuration
# Server-side frontend API URL.
# When running frontend and backend separately without Docker, this must point
# to the locally reachable backend address.
API_URL=http://localhost:8080
# Client-side accessible API URL - must include protocol and port.
# This value must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Multi-Tenancy
# Base domain for subdomain-based tenant routing (proxy extracts slug from {slug}.{TENANT_DOMAIN})
# Development: localhost — e.g., school-a.localhost:3000
# Production: your-domain.com — e.g., school-a.your-domain.com
TENANT_DOMAIN=localhost
# Client-side tenant domain (for browser-based tenant switching)
NEXT_PUBLIC_TENANT_DOMAIN=localhost

# Operator Subdomain (for session isolation)
NEXT_PUBLIC_OPERATOR_HOSTNAME=operator.localhost:3000

# Parents Subdomain (cross-tenant guardian portal — session-isolated)
NEXT_PUBLIC_PARENTS_HOSTNAME=parents.localhost:3000

# PostHog Product Analytics (EU Cloud)
# NOTE: for deployed builds these NEXT_PUBLIC_* values are build-time-inlined
# via build-args in .github/workflows/build.yml — the SOPS env values do not
# reach the client bundle.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Error Tracking (optional — not needed for local dev)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# Development Options
SKIP_ENV_VALIDATION=true # Set to false to enforce validation during development
NEXT_TELEMETRY_DISABLED=1
# Frontend structured logging level (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info
# Trust the Host header from reverse proxy (required when behind nginx/caddy/traefik)
AUTH_TRUST_HOST=true
