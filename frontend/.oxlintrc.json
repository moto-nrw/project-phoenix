{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "jsx-a11y", "import", "promise"],
  "jsPlugins": [
    "./scripts/oxlint-plugin-bauart.mjs",
    "./scripts/oxlint-plugin-date-safety.mjs",
    "./scripts/oxlint-plugin-logging-safety.mjs",
    "./scripts/oxlint-plugin-test-clock.mjs",
    "./scripts/oxlint-plugin-ui-kit.mjs"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "warn"
  },
  "rules": {
    "bauart/one-delete-confirm": "error",
    "bauart/no-row-action-buttons": "error",
    "bauart/no-unconfirmed-destructive-click": "error",
    "bauart/no-autosave": "error",
    "bauart/no-toast-form-error": "error",
    "bauart/no-manage-surface-in-overlay": "error",
    "bauart/one-detail-per-type": "error",
    "bauart/no-edit-overlay": "error",
    "bauart/no-local-field-grid": "error",
    "bauart/no-own-skeleton": "error",
    "bauart/no-raw-status-hex": "error",
    "bauart/no-disabled-menu-item": "error",
    "date-safety/no-utc-date-extraction": "error",
    "logging-safety/no-serialized-context": "error",
    "test-clock/no-real-clock": "error",
    "ui-kit/no-generic-brand-colors": "error",
    "ui-kit/no-hand-rolled-overlay": "error",
    "ui-kit/no-hand-rolled-surface": "error",
    "ui-kit/require-checkbox-label": "error",
    "ui-kit/no-rounded-3xl": "error",
    "ui-kit/no-tenant-kicker": "error",
    "ui-kit/no-handrolled-surface": "error",
    "ui-kit/no-tabs-as-value-switcher": "error",
    "ui-kit/no-tiny-text": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "date-fns",
            "message": "Import each function from its submodule (date-fns/format). The root barrel loads all of date-fns in every test file and client chunk. Type imports are fine.",
            "allowTypeImports": true
          },
          {
            "name": "date-fns/locale",
            "message": "Import the locale from date-fns/locale/<code> (date-fns/locale/de). The barrel loads every locale.",
            "allowTypeImports": true
          },
          {
            "name": "react-day-picker",
            "message": "Render the calendar through LazyDayPicker from ~/components/ui/lazy-day-picker, so react-day-picker loads only when a calendar opens. Type imports are fine.",
            "allowTypeImports": true
          }
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-unsafe-type-assertion": "off",
    "import/no-unassigned-import": "off",
    "no-shadow": "off",
    "no-await-in-loop": "off",
    "no-array-index-key": "off",
    "promise/always-return": "off",
    "import/no-named-as-default": "off",
    "jsx-a11y/autocomplete-valid": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["node_modules", ".next", "out", "storybook-static"]
}
