# Staging Environment Configuration
# Encrypted with SOPS — do NOT edit manually. Use: sops edit environments/staging.sops.env
#
# After editing, commit the encrypted file. CI will decrypt and deploy automatically.

# Timezone
TZ=Europe/Berlin

# Database
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
DB_DSN=postgres://postgres:CHANGE_ME_staging_db_password@postgres:5432/postgres?sslmode=require
PHOENIX_AUTH_PASSWORD=CHANGE_ME_staging_phoenix_auth_password

# Server
PORT=8080
LOG_LEVEL=info
LOG_TEXTLOGGING=false
APP_ENV=production
DB_DEBUG=false
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=https://staging.moto-app.de,https://api-staging.moto-app.de,https://operator-staging.moto-app.de

# Rate Limiting (enabled for staging to match production behavior)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Security Logging
SECURITY_LOGGING_ENABLED=true

# Authentication
AUTH_JWT_SECRET=CHANGE_ME_staging_jwt_secret_at_least_32_chars
AUTH_JWT_EXPIRY=15m
AUTH_JWT_REFRESH_EXPIRY=1h

# Frontend
NEXT_PUBLIC_API_URL=https://api-staging.moto-app.de
NEXTAUTH_URL=https://staging.moto-app.de
NEXTAUTH_SECRET=CHANGE_ME_staging_nextauth_secret_at_least_32_chars
AUTH_TRUST_HOST=true

# Multi-Tenancy
TENANT_DOMAIN=staging.moto-app.de
NEXT_PUBLIC_TENANT_DOMAIN=staging.moto-app.de
NEXT_PUBLIC_OPERATOR_HOSTNAME=operator-staging.moto-app.de

# Admin Account (initial setup)
ADMIN_EMAIL=admin@moto-app.de
ADMIN_PASSWORD=CHANGE_ME_staging_admin_password

# Operator Account (initial setup via migration)
OPERATOR_EMAIL=operator@moto-app.de
OPERATOR_PASSWORD=CHANGE_ME_staging_operator_password
OPERATOR_DISPLAY_NAME=Administrator

# Email / SMTP
EMAIL_SMTP_HOST=CHANGE_ME_smtp_host
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=CHANGE_ME_smtp_user
EMAIL_SMTP_PASSWORD=CHANGE_ME_smtp_password
EMAIL_FROM_NAME=MOTO Staging
EMAIL_FROM_ADDRESS=noreply@moto-app.de
FRONTEND_URL=https://staging.moto-app.de
INVITATION_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Suggestion Notifications
SUGGESTION_NOTIFY_EMAIL=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=CHANGE_ME_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Development flags (disabled in staging)
SKIP_ENV_VALIDATION=false
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LOG_LEVEL=info

# Scheduled Tasks
CLEANUP_SCHEDULER_ENABLED=true
CLEANUP_SCHEDULER_TIME=02:00
CLEANUP_SCHEDULER_TIMEOUT_MINUTES=30

# Session Lifecycle
SESSION_END_SCHEDULER_ENABLED=true
SESSION_END_TIME=18:00
SESSION_END_TIMEOUT_MINUTES=10
STUDENT_DAILY_CHECKOUT_TIME=15:00

# Abandoned Session Cleanup
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_INTERVAL_MINUTES=15
SESSION_ABANDONED_THRESHOLD_MINUTES=60

# Device Authentication
OGS_DEVICE_PIN=CHANGE_ME_staging_device_pin
