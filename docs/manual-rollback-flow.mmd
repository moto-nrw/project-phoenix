---
title: Project Phoenix — Manual Rollback Flow (workflow_dispatch)
---
flowchart TD
    START([Manual Trigger\nworkflow_dispatch]) --> INPUTS["Inputs:\n• environment (staging/demo/production)\n• target_sha (optional)\n• restore_db (boolean)"]

    INPUTS --> HAS_SHA{target_sha\nprovided?}
    HAS_SHA -->|yes| USE_INPUT[Use provided SHA]
    HAS_SHA -->|no| READ_STATE["SSH: read .deploy-state\nfrom server"]
    READ_STATE --> HAS_PREV{PREVIOUS_SHA\nexists?}
    HAS_PREV -->|no| FAIL_NO_STATE["FAIL: No previous SHA known.\nProvide target_sha manually."]
    HAS_PREV -->|yes| USE_PREV[Use PREVIOUS_SHA\nfrom .deploy-state]

    USE_INPUT & USE_PREV --> VERIFY

    %% ─── Verification ───
    subgraph VERIFY [Verify Rollback Target]
        V1["docker manifest inspect\nghcr.io/moto-nrw/phoenix-server:SHA"] --> V1_OK{Backend\nimage exists?}
        V1_OK -->|no| FAIL_NO_IMAGE["FAIL: Image :SHA not found in GHCR.\nCheck SHA or GHCR retention."]
        V1_OK -->|yes| V2["docker manifest inspect\nghcr.io/moto-nrw/phoenix-frontend:SHA"]
        V2 --> V2_OK{Frontend\nimage exists?}
        V2_OK -->|no| FAIL_NO_IMAGE
        V2_OK -->|yes| PROCEED
    end

    %% ─── Rollback Execution ───
    PROCEED --> DB_RESTORE{restore_db\n= true?}

    DB_RESTORE -->|no| SKIP_DB[Skip DB restore\nImage-only rollback]
    DB_RESTORE -->|yes| FIND_BACKUP

    subgraph DB_ROLLBACK [Database Restore]
        FIND_BACKUP["Find latest backup in\n~/backups/{env}/"] --> BACKUP_EXISTS{Backup\nfound?}
        BACKUP_EXISTS -->|no| FAIL_NO_BACKUP["FAIL: No backup files found.\nManual intervention needed."]
        BACKUP_EXISTS -->|yes| STOP_APPS["docker compose stop\nserver frontend"]
        STOP_APPS --> DROP_DB["psql -d template1:\nTerminate connections\nDROP DATABASE postgres\nCREATE DATABASE postgres TEMPLATE template0"]
        DROP_DB --> RESTORE["pg_restore -d postgres\n--exit-on-error backup.dump\nVerify role privileges"]
        RESTORE --> RESTORE_OK{Restore\nsucceeded?}
        RESTORE_OK -->|no| FAIL_RESTORE["FAIL: DB restore failed.\nBackup may be corrupted.\nManual intervention needed."]
        RESTORE_OK -->|yes| DB_DONE[DB restored]
    end

    SKIP_DB & DB_DONE --> DEPLOY_OLD

    subgraph DEPLOY_OLD [Deploy Previous Version]
        D1["Update docker-compose.yml:\nserver image → :SHA\nfrontend image → :SHA"] --> D2[docker compose pull]
        D2 --> D3["docker compose up -d --wait"]
        D3 --> D3_OK{Healthcheck\npassed?}
        D3_OK -->|no| FAIL_ROLLBACK["FAIL: Rolled-back version\nalso unhealthy.\nManual intervention needed."]
        D3_OK -->|yes| UPDATE_STATE["Update .deploy-state:\nCURRENT_SHA = target_sha"]
    end

    UPDATE_STATE --> DONE(["Rollback complete.\nReport SHA + environment."])
