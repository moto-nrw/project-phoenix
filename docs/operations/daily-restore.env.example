# Separate restore machine only. Materialize via operator SOPS, mode 0600.
# Blank values are REQUIRED, not defaults. Use new drill-only credentials.
TZ=UTC
RESTORE_POSTGRES_PORT=55432
RESTORE_DATABASE_VOLUME=moto-restore-drill-database
POSTGRES_PASSWORD=
PHOENIX_AUTH_PASSWORD=
PHOENIX_DEMO_PASSWORD=
# Also fill the transport/workspace values from daily-backup.env.example.
# Point COMPOSE_FILE/project/uploads to the isolated drill, not production.
BACKUP_COMPOSE_FILE=/srv/moto-restore/compose.yml
BACKUP_PROJECT=moto-restore-drill
BACKUP_UPLOADS_VOLUME=moto-restore-drill-uploads
# Restore only: protected offline identity, never on the source host.
BACKUP_AGE_IDENTITY_FILE=
