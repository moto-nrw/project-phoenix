# Dedicated systemd environment, NOT an application/Compose environment.
# Fill every blank through a separate operator-managed SOPS document.
# Never commit its plaintext or put an age private identity on the source host.
PATH=
BACKUP_COMPOSE_FILE=
BACKUP_PROJECT=
BACKUP_UPLOADS_VOLUME=
BACKUP_TRANSPORT=s3
BACKUP_TARGET=
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_WORK_DIR=/run/moto-backup
RCLONE_CONFIG_MOTO_PROVIDER=
RCLONE_CONFIG_MOTO_ENDPOINT=
RCLONE_CONFIG_MOTO_REGION=
RCLONE_CONFIG_MOTO_ACCESS_KEY_ID=
RCLONE_CONFIG_MOTO_SECRET_ACCESS_KEY=
