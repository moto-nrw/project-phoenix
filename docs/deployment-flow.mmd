---
title: Project Phoenix — Deployment & Rollback Flow
---
flowchart TD
    %% ─── Trigger ───
    START([CI Trigger]) --> ENV_CHECK{Determine\nEnvironment}
    ENV_CHECK -->|push main| PROD[Production]
    ENV_CHECK -->|push development| STAGING[Staging]
    ENV_CHECK -->|PR merged + label| DEMO[Demo]
    ENV_CHECK -->|workflow_dispatch| MANUAL[Manual Target]

    PROD & STAGING & DEMO & MANUAL --> BUILD

    %% ─── Build Phase ───
    subgraph BUILD [Build Phase — GitHub Actions Runner]
        B1[Checkout code] --> B2[Build backend image]
        B1 --> B3[Build frontend image]
        B2 --> B4[Push to GHCR\nTags: branch, SHA, env]
        B3 --> B5[Push to GHCR\nTags: branch, SHA, env]
    end

    B4 & B5 --> DEPLOY_START

    %% ─── Deploy Phase ───
    subgraph DEPLOY ["Deploy Phase — Remote Server via SSH (~/{env}/)"]
        DEPLOY_START[Start Deploy] --> BACKUP_CONFIG["Backup config on server\ncp .env → .env.rollback\ncp docker-compose.yml → docker-compose.yml.rollback"]
        BACKUP_CONFIG --> SCP["SCP new files to server\n.env (decrypted from SOPS)\ndocker-compose.yml"]
        SCP --> PULL[docker compose pull\nnew images from GHCR]
        PULL --> STOP["docker compose stop\nserver frontend\n(postgres stays up)"]
        STOP --> BACKUP_DB["pg_dump -Fc → backup file\n(DB frozen — no app writing)"]
        BACKUP_DB --> BACKUP_OK{Backup\nnon-empty?}
        BACKUP_OK -->|empty / failed| ABORT_RESTORE

        %% ─── Abort: Backup Failed ───
        subgraph ABORT ["Abort — Backup Failed"]
            direction TB
            ABORT_RESTORE["Restore config:\n.env.rollback → .env\ndocker-compose.yml.rollback → docker-compose.yml"]
            ABORT_RESTORE --> ABORT_PULL["docker compose pull\n(old compose = old image tags)"]
            ABORT_PULL --> ABORT_UP["docker compose up -d --wait"]
            ABORT_UP --> ABORT_EXIT["EXIT 1"]
        end

        BACKUP_OK -->|ok| MIGRATE["docker compose run --rm\nserver ./main migrate"]
        MIGRATE --> MIG_OK{Migration\nsucceeded?}
        MIG_OK -->|yes| UP["docker compose up -d --wait"]
        MIG_OK -->|no| ROLLBACK

        UP --> HEALTH{Healthcheck\npassed?\n--wait timeout}
        HEALTH -->|yes| SUCCESS
        HEALTH -->|no| ROLLBACK

        %% ─── Rollback ───
        subgraph ROLLBACK [Automatic Rollback]
            direction TB
            R1["docker compose stop\nserver frontend\n(idempotent — may already be stopped)"]
            R1 --> R2["Restore DB:\npsql -d template1:\n  terminate connections\n  DROP DATABASE postgres\n  CREATE DATABASE postgres TEMPLATE template0\npg_restore --exit-on-error backup.dump\nVerify role privileges"]
            R2 --> R3["Restore config:\n.env.rollback → .env\ndocker-compose.yml.rollback → docker-compose.yml"]
            R3 --> R4["docker compose pull\n(old compose = old image tags)"]
            R4 --> R5["docker compose up -d --wait"]
            R5 --> R6{Old version\nhealthy?}
            R6 -->|yes| R7["Report: Deploy FAILED\nRolled back to previous SHA\nEXIT 1"]
            R6 -->|no| R8["CRITICAL: Rollback ALSO failed!\nSend email alert to team\nEXIT 1"]
        end

        %% ─── Success ───
        subgraph SUCCESS [Deploy Succeeded]
            direction TB
            S1["Write ~/{env}/.deploy-state\nCURRENT_SHA=new\nPREVIOUS_SHA=old\nBACKUP_FILE=path\nDEPLOYED_AT=timestamp"]
            S1 --> S2["Cleanup:\nrm .env.rollback\nrm docker-compose.yml.rollback\nRotate old backups (keep N)"]
            S2 --> S3["Report: Deploy complete"]
        end
    end
