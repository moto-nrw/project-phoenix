# Devbox + direnv integration
# Run `direnv allow` once to trust this file
watch_file scripts/devbox-tmpdir.sh scripts/cleanup-devbox-tmp.mjs
moto_devbox_bootstrap() {
  # Keep Devbox's PATH and exports, but restore the caller's TMPDIR afterwards.
  local TMPDIR=${TMPDIR-}
  source scripts/devbox-tmpdir.sh || return
  eval "$(devbox generate direnv --print-envrc)"
  node scripts/cleanup-devbox-tmp.mjs
}
moto_devbox_bootstrap || return
unset -f moto_devbox_bootstrap

# Machine-local overrides (e.g. TEST_DB_DSN for checkouts without a .env,
# such as review worktrees). Absent on machines that don't need them.
dotenv_if_exists ~/.config/project-phoenix/local.env
dotenv_if_exists .wt.env
